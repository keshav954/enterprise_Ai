# Environment variables (NEVER commit secrets)
.env
.env.*
!.env.example

# Python virtual environment
venv/
env/
.venv/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Distribution / packaging
dist/
build/
*.egg-info/
*.zip

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local databases & WAL files
*.db
*.db-shm
*.db-wal
app/memory/memory.db
data/memory.db*

# Vector store runtime data
data/chroma/

# Test artifacts and coverage
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/

# Generated reports & charts from test runs
reports/report_*.md
reports/charts/*.html

# Test-generated files in knowledge base
knowledge_base/test_policy_doc.md

# Per-user workspace isolation folders
workspace/*
!workspace/.gitkeep
!workspace/operations_tasks.csv
