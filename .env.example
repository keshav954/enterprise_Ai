# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Environment (development | production)
# In production, APP_API_KEY is required and service refuses to start without it.
ENV=development

# Application API Key Authentication (comma-separated list allowed)
# Required on all API endpoints except GET /health and static files.
# Clients send header: Authorization: Bearer <key>
APP_API_KEY=your_secret_api_key_here

# Allowed CORS Origins (comma-separated list, e.g. http://localhost:8000,http://127.0.0.1:8000)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Rate Limiting: Max requests per minute per API key
RATE_LIMIT_PER_MIN=30

# Request Validation: Maximum message length in characters (default 4000)
MAX_MESSAGE_CHARS=4000

# SQLite Persistent Memory DB Path (defaults to app/memory/memory.db)
MEMORY_DB_PATH=
